{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinasafe",
  "mainBinaryName": "cinasafe-app",
  "version": "0.2.2",
  "identifier": "org.cinasafe.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: cinasafe-img: http://cinasafe-img.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Video",
    "shortDescription": "Encrypted, portable movie and TV library on a USB stick",
    "longDescription": "Cinasafe turns a USB stick into an encrypted, portable movie and TV library with a streaming-service interface. Nothing is decrypted to the computer's disk.",
    "homepage": "https://github.com/yuvalkolodkingal/cinasafe",
    "publisher": "Cinasafe contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "resources": { "fonts/": "fonts/" }
  }
}
