{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cinasafe-embed-spike",
  "version": "0.1.0",
  "identifier": "org.cinasafe.spike",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cinasafe embed spike",
        "width": 1280,
        "height": 720,
        "transparent": true,
        "incognito": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
