{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinasafe",
  "mainBinaryName": "cinasafe-app",
  "version": "0.1.0",
  "identifier": "org.cinasafe.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cinasafe (developer preview)",
        "width": 1280,
        "height": 720,
        "transparent": true,
        "incognito": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Video",
    "shortDescription": "Encrypted, portable movie and TV library on a USB stick",
    "longDescription": "Cinasafe turns a USB stick into an encrypted, portable movie and TV library with a streaming-service interface. This is a developer preview of the playback shell.",
    "homepage": "https://github.com/yuvalkolodkingal/cinasafe",
    "publisher": "Cinasafe contributors"
  }
}
